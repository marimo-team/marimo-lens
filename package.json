{
  "name": "marimo-lens",
  "private": true,
  "scripts": {
    "dev": "esbuild js/widget.tsx --format=esm --bundle --alias:@=./js --outdir=src/marimo_lens/static --sourcemap=inline --watch",
    "build": "esbuild js/widget.tsx --minify --format=esm --bundle --alias:@=./js --outdir=src/marimo_lens/static",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint js",
    "lint:fix": "oxlint js --fix",
    "test": "vitest run --environment jsdom",
    "fmt": "oxfmt js package.json tsconfig.json vitest.config.ts pyproject.toml README.md AGENTS.md .oxlintrc.json .oxfmtrc.json",
    "fmt:check": "oxfmt --check js package.json tsconfig.json vitest.config.ts pyproject.toml README.md AGENTS.md .oxlintrc.json .oxfmtrc.json",
    "qa:package": "MARIMO_LENS_RUN_PACKAGE_ARTIFACTS=1 uv run pytest tests/test_package_artifacts.py",
    "qa": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@anywidget/react": "^0.2.1",
    "@use-gesture/react": "10.3.1",
    "lucide-react": "1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "valibot": "1.4.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "jsdom": "29.1.1",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "typescript": "^6.0.2",
    "vitest": "4.1.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "reactDoctor": {
    "ignore": {
      "files": [
        "src/marimo_lens/static/**"
      ]
    }
  }
}
